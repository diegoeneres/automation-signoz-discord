DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN
PUBLIC_BASE_URL=https://alertas.dnrxconsultoria.com
TICKET_SIGNING_SECRET=gere_um_segredo_longo_e_aleatorio
JIRA_BASE_URL=https://sua-empresa.atlassian.net
JIRA_EMAIL=voce@empresa.com
JIRA_API_TOKEN=cole_o_token_da_api
JIRA_PROJECT_KEY=OPS
JIRA_ISSUE_TYPE=Task
SIGNOZ_WEBHOOK_TOKEN=gere_um_segredo_longo
SMS_PROVIDERS=twilio,infobip
# Lista comum usada pelos dois provedores. A variavel antiga TWILIO_SMS_RECIPIENTS
# continua aceita como fallback de configuracao.
SMS_RECIPIENTS=+5511999999999
TWILIO_ENABLED=true
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=cole_o_auth_token_da_conta
# Em producao, prefira API Key. Quando preenchida, ela tem prioridade sobre o Auth Token.
# TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SECRET=cole_o_secret_exibido_ao_criar_a_api_key
TWILIO_FROM_NUMBER=+15551234567
TWILIO_SMS_RECIPIENTS=+5511999999999
# Contas trial recentes exigem o nome exato de um template predefinido.
# Deixe vazio em contas com acesso completo para enviar os detalhes do alerta.
TWILIO_SMS_TEMPLATE=sms_internal_alerts
# Para vários destinatários, separe os números por vírgula no formato E.164.
# TWILIO_API_BASE_URL=https://api.twilio.com/2010-04-01
INFOBIP_ENABLED=false
INFOBIP_BASE_URL=https://xxxxx.api.infobip.com
INFOBIP_API_KEY=cole_a_api_key_com_escopo_sms_message_send
INFOBIP_SENDER=Alertas
DATABASE_PATH=data/service.db

# OpenTelemetry -> SigNoz Cloud (OTLP/HTTP sobre TLS).
# Copie endpoint e ingestion key em Settings > Ingestion Settings no SigNoz.
OTEL_SERVICE_NAME=signoz-discord-jira
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.<region>.signoz.cloud:443
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=SUA_INGESTION_KEY
OTEL_EXPORTER_OTLP_COMPRESSION=gzip
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production,service.version=0.4.0
